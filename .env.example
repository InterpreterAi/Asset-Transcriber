# Local API (artifacts/api-server): copy to `.env` or `.env.local` at the **repository root**
# so Drizzle and the API see the same vars. Restart `pnpm run dev` / api-server after editing.

# Postgres (local or tunnel URL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Public URL for OAuth redirects and email links (local UI is usually http://localhost:5173)
APP_URL=http://localhost:5173

# Resend — required for signup verification, password reset, support mail, and scheduled reminders
RESEND_API_KEY=

# Soniox — required for live transcription (/api/transcription/token)
SONIOX_API_KEY=
# Aliases: SONIOX_STT_API_KEY, SONIOX_KEY, SONIOX_API_TOKEN (case-insensitive env names OK)

# *-libre machine translation: default base is hetzner-translate.ts (Hetzner). Overrides must not use *.railway.internal (ignored).
# Override if you move servers (full base URL, no trailing /translate — e.g. http://203.0.113.10:5000).
LIBRETRANSLATE_INTERNAL_URL=
LIBRETRANSLATE_URL=

# OpenAI — storyboard + reel-builder routes
OPENAI_API_KEY=

# Pexels — portrait hook b-roll for Creative Studio reels (https://www.pexels.com/api/)
PEXELS_API_KEY=

# Google AI (Gemini) — Veo hook footage in Creative Studio (requires billing on Gemini API)
GOOGLE_AI_API_KEY=
# Aliases: GEMINI_API_KEY, GOOGLE_AI_PRO_API_KEY
# Optional model override (default veo-3.1-fast-generate-preview):
# GOOGLE_VEO_MODEL=veo-3.1-generate-preview

# ElevenLabs — hook + workspace + outro voiceover (reel-builder)
ELEVENLABS_API_KEY=
